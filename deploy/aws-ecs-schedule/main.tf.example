# UNTESTED TEMPLATE. Never applied to a real account. Rename to main.tf only in a sandbox account.
#
# (a) EventBridge Scheduler -> ECS Fargate task, every 6 hours.
# Why ECS and not Lambda: `terraform plan` on a big state can run longer than Lambda's 15-minute limit.
#
# Assumes the image is in ECR, a VPC with a subnet that can reach the internet (GitHub, the LLM, AWS APIs),
# and a Secrets Manager secret for each key below. CHANGE_ME marks what you must fill in.

variable "image" { default = "CHANGE_ME.dkr.ecr.eu-west-1.amazonaws.com/driftpilot:2.0.0" }
variable "subnet_ids" { type = list(string) } # CHANGE_ME
variable "security_group_ids" { type = list(string) }
variable "github_token_secret_arn" { type = string } # secret holding DRIFTPILOT_GITHUB_TOKEN
variable "llm_key_secret_arn" { type = string }      # secret holding DRIFTPILOT_LLM_API_KEY
variable "state_bucket" { default = "CHANGE_ME-terraform-state" }

resource "aws_ecs_cluster" "driftpilot" { name = "driftpilot" }

resource "aws_cloudwatch_log_group" "driftpilot" {
  name              = "/driftpilot"
  retention_in_days = 30
}

# Execution role: lets ECS pull the image, write logs and read ONLY the two secrets.
resource "aws_iam_role" "execution" {
  name = "driftpilot-execution"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "ecs-tasks.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })
}
resource "aws_iam_role_policy_attachment" "execution" {
  role       = aws_iam_role.execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}
resource "aws_iam_role_policy" "read_secrets" {
  role = aws_iam_role.execution.id
  policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Action = "secretsmanager:GetSecretValue", Resource = [var.github_token_secret_arn, var.llm_key_secret_arn] }]
  })
}

# Task role: what DriftPilot itself may do. Read-only, see deploy/README.md.
resource "aws_iam_role" "task" {
  name = "driftpilot-task"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "ecs-tasks.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })
}
resource "aws_iam_role_policy_attachment" "read_only" {
  role       = aws_iam_role.task.name
  policy_arn = "arn:aws:iam::aws:policy/ReadOnlyAccess" # quick start; replace with a tighter list
}
resource "aws_iam_role_policy" "state_and_scanner" {
  role = aws_iam_role.task.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      { Effect = "Allow", Action = ["s3:GetObject", "s3:ListBucket"], Resource = ["arn:aws:s3:::${var.state_bucket}", "arn:aws:s3:::${var.state_bucket}/*"] },
      { Effect = "Allow", Action = ["s3:ListAllMyBuckets", "s3:GetBucketLocation", "ec2:DescribeSecurityGroups", "iam:ListUsers"], Resource = "*" },
    ]
  })
}

resource "aws_ecs_task_definition" "driftpilot" {
  family                   = "driftpilot"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = 1024
  memory                   = 2048
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn
  container_definitions = jsonencode([{
    name  = "driftpilot"
    image = var.image
    # The image's entrypoint is `driftpilot`; the command picks the sub-command.
    command = ["action"]
    environment = [
      { name = "DRIFTPILOT_WORKING_DIRECTORY", value = "/workspace" }, # CHANGE_ME: how the Terraform code gets here
      { name = "DRIFTPILOT_MODE", value = "advise" },
      { name = "GITHUB_REPOSITORY", value = "CHANGE_ME/owner-repo" },
    ]
    secrets = [
      { name = "DRIFTPILOT_GITHUB_TOKEN", valueFrom = var.github_token_secret_arn },
      { name = "DRIFTPILOT_LLM_API_KEY", valueFrom = var.llm_key_secret_arn },
    ]
    logConfiguration = {
      logDriver = "awslogs"
      options   = { awslogs-group = aws_cloudwatch_log_group.driftpilot.name, awslogs-region = "eu-west-1", awslogs-stream-prefix = "run" }
    }
  }])
}

# The schedule needs a role that may start the task (and pass the two roles above to it).
resource "aws_iam_role" "scheduler" {
  name = "driftpilot-scheduler"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "scheduler.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })
}
resource "aws_iam_role_policy" "run_task" {
  role = aws_iam_role.scheduler.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      { Effect = "Allow", Action = "ecs:RunTask", Resource = aws_ecs_task_definition.driftpilot.arn },
      { Effect = "Allow", Action = "iam:PassRole", Resource = [aws_iam_role.execution.arn, aws_iam_role.task.arn] },
    ]
  })
}

resource "aws_scheduler_schedule" "every_six_hours" {
  name                = "driftpilot-every-6h"
  schedule_expression = "rate(6 hours)"
  flexible_time_window { mode = "OFF" }
  target {
    arn      = aws_ecs_cluster.driftpilot.arn
    role_arn = aws_iam_role.scheduler.arn
    ecs_parameters {
      task_definition_arn = aws_ecs_task_definition.driftpilot.arn
      launch_type         = "FARGATE"
      network_configuration {
        subnets          = var.subnet_ids
        security_groups  = var.security_group_ids
        assign_public_ip = true # needed only if the subnet has no NAT gateway
      }
    }
  }
}

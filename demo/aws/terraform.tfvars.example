# Copy this file to terraform.tfvars (which is gitignored) only if you need to change something.
#   cp terraform.tfvars.example terraform.tfvars
# The default scope ("s3": one bucket in us-east-1) needs NO settings at all, so you can skip this file.
# Never commit terraform.tfvars. Never put AWS keys in it: keys live in your AWS profile, not here.

# Which demo to build. scripts/aws_demo.sh and `driftpilot scan` both read it from this file.
#   "s3"   = one S3 bucket in us-east-1 (default)
#   "full" = bucket + security group + small RDS database in ap-south-1
# demo_scope = "s3"

# ---- Only for the "full" scope (later, if the account is upgraded) ----
# Your public IP as a /32. Find it with:  curl -s https://checkip.amazonaws.com   (then add /32)
# my_ip_cidr = "203.0.113.7/32"

# Optional (full scope only): a spending alert. Needs an email you can read.
# enable_budget_guard = true
# budget_email        = "you@example.com"
# budget_limit_usd    = 20

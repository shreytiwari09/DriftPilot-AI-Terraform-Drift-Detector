{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListAllBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3DemoBucketsRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetAccelerateConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::driftpilot-demo-*",
        "arn:aws:s3:::driftpilot-demo-*/*"
      ]
    },
    {
      "Sid": "TaggingFindDemoResources",
      "Effect": "Allow",
      "Action": [
        "tag:GetResources"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}

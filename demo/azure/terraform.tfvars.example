# Copy this file to terraform.tfvars (which is gitignored), then edit it:
#   cp demo/azure/terraform.tfvars.example demo/azure/terraform.tfvars
# Never commit terraform.tfvars. No passwords or keys belong in it: Azure access comes from `az login`.

# REQUIRED. Your public IP address as a /32: only this address may reach SSH (port 22) in the demo's firewall rule.
# Find it with:  curl -s https://checkip.amazonaws.com    (then add /32 at the end)
# 0.0.0.0/0 and * are refused on purpose.
my_ip_cidr = "203.0.113.7/32"

# Where everything is created. Your subscription's Azure Policy "Allowed resource deployment regions" (set by Azure for
# Students, not by this demo) allows only these five, and Terraform refuses any other:
#   koreacentral (default), indiasouthcentral, eastasia, malaysiawest, indonesiacentral
# scripts/azure_demo.sh asks you to type the region name before apply and destroy.
# location = "koreacentral"

# Optional. Leave unset: scripts/azure_demo.sh takes the subscription your `az login` session is using.
# subscription_id = "00000000-0000-0000-0000-000000000000"
